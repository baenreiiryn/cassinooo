<section class="cassinooo-table-shell">
  <header class="cassinooo-table-header">
    <div>
      <h2>Mesa do Cassino</h2>
      <p>Blackjack compartilhado em tempo real para até 6 jogadores.</p>
    </div>
    {{#if isGM}}
      <div class="cassinooo-gm-controls">
        <span class="cassinooo-gm-badge"><i class="fa-solid fa-crown"></i> Controle do Mestre</span>
        {{#if roundActive}}
          <button type="button" data-reset-round><i class="fa-solid fa-rotate-left"></i> Reiniciar rodada</button>
        {{else}}
          <button type="button" data-start-round><i class="fa-solid fa-cards"></i> Distribuir cartas</button>
          {{#if hasRound}}
            <button type="button" data-reset-round><i class="fa-solid fa-rotate-left"></i> Limpar mesa</button>
          {{/if}}
        {{/if}}
      </div>
    {{/if}}
  </header>

  <div class="cassinooo-message" aria-live="polite">{{message}}</div>

  <div class="cassinooo-board">
    <div class="cassinooo-felt">
      <section class="cassinooo-dealer-zone">
        <span class="cassinooo-role-label">DEALER / MESTRE</span>
        <strong>{{dealerName}}</strong>
        <div class="cassinooo-hand cassinooo-dealer-hand">
          {{#each dealerCards}}
            <div class="cassinooo-playing-card {{#if hidden}}hidden-card{{/if}} {{#if red}}red{{/if}}">{{label}}</div>
          {{/each}}
        </div>
        {{#if showDealerScore}}<span class="cassinooo-score">Pontuação: {{dealerScore}}</span>{{/if}}
      </section>

      <div class="cassinooo-table-marking">
        <strong>BLACKJACK</strong>
        <span>Dealer para em 17</span>
      </div>

      {{#each seats}}
        <article class="cassinooo-seat {{positionClass}}">
          <span class="cassinooo-seat-number">Lugar {{number}}</span>

          {{#if ../isGM}}
            <select data-seat-index="{{index}}" aria-label="Jogador do lugar {{number}}">
              <option value="">— Lugar vazio —</option>
              {{#each options}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}{{#unless active}} (offline){{/unless}}</option>
              {{/each}}
            </select>
          {{else}}
            <strong class="cassinooo-player-name">{{occupantName}}</strong>
            {{#if occupied}}
              <small class="cassinooo-status {{#if occupantActive}}online{{else}}offline{{/if}}">
                {{#if occupantActive}}Online{{else}}Offline{{/if}}
              </small>
            {{/if}}
          {{/if}}

          <div class="cassinooo-hand">
            {{#each cards}}
              <div class="cassinooo-playing-card {{#if red}}red{{/if}}">{{label}}</div>
            {{/each}}
            {{#unless cards.length}}
              <span class="cassinooo-empty-hand">Sem cartas</span>
            {{/unless}}
          </div>

          {{#if hasHand}}
            <div class="cassinooo-hand-meta">
              <span class="cassinooo-score">{{score}}</span>
              {{#if result}}<span class="cassinooo-result">{{result}}</span>{{/if}}
            </div>
          {{/if}}

          {{#if canAct}}
            <div class="cassinooo-player-actions">
              <button type="button" data-blackjack-action="hit"><i class="fa-solid fa-plus"></i> Pedir</button>
              <button type="button" data-blackjack-action="stand"><i class="fa-solid fa-hand"></i> Parar</button>
            </div>
          {{/if}}
        </article>
      {{/each}}
    </div>
  </div>

  <footer class="cassinooo-table-footer">
    <strong>Regras atuais:</strong> Blackjack natural = 21 com 2 cartas; Ás vale 1 ou 11; figuras valem 10; Dealer compra até 16 e para em qualquer 17. Dividir, dobrar, seguro e apostas entram depois.
  </footer>
</section>
