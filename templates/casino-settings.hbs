<section class="cassinooo-settings-shell">
  <header class="cassinooo-settings-header">
    <h2><i class="fa-solid fa-image"></i> Fundos das mesas</h2>
    <p>Escolha uma imagem já existente ou faça upload pelo File Picker do Foundry. Os caminhos são salvos para todo o mundo.</p>
  </header>

  <div class="cassinooo-settings-grid">
    {{#each games}}
      <article class="cassinooo-background-setting">
        <div class="cassinooo-background-title">
          <i class="{{icon}}"></i>
          <strong>{{label}}</strong>
        </div>

        <div class="cassinooo-background-preview">
          {{#if value}}
            <img src="{{value}}" alt="Prévia do fundo de {{label}}">
          {{else}}
            <span><i class="fa-solid fa-image"></i> Sem imagem definida</span>
          {{/if}}
        </div>

        <div class="cassinooo-background-input-row">
          <input type="text" name="{{id}}" value="{{value}}" placeholder="Caminho da imagem no User Data">
          <button type="button" data-file-picker data-type="image" data-target="{{id}}" title="Procurar ou fazer upload">
            <i class="fa-solid fa-folder-open"></i>
          </button>
          <button type="button" data-clear-background="{{id}}" title="Remover fundo">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </article>
    {{/each}}
  </div>

  <footer class="cassinooo-settings-footer">
    <p><i class="fa-solid fa-circle-info"></i> No Foundry V13, faça upload para uma pasta permitida do User Data, como <strong>assets</strong> ou uma pasta dentro do mundo atual.</p>
    <button type="button" data-save-backgrounds><i class="fa-solid fa-floppy-disk"></i> Salvar fundos</button>
  </footer>
</section>
